# 数据库
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/yvci

# 应用密钥
SECRET_KEY=your-secret-key

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://your-domain.com

# GitHub OAuth（可选）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 腾讯云 COS（图床，仅后台上传图片时需要真实配置）
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_BUCKET=yvce-1365610295
COS_REGION=ap-guangzhou
COS_DOMAIN=https://yvce-1365610295.cos.ap-guangzhou.myqcloud.com
COS_PREFIX=uploads/
