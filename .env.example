# ===== 前端构建变量 =====
NEXT_PUBLIC_API_URL=http://你的域名
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# ===== 后端运行时 =====
# 数据库：云服务器上已有的 PostgreSQL
DATABASE_URL=postgresql://postgres:你的数据库密码@127.0.0.1:5432/yvci
# 应用密钥（用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成）
SECRET_KEY=请替换为随机串
CORS_ORIGINS=http://你的域名,http://localhost:3000,http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 腾讯云 COS 图床
COS_SECRET_ID=你的COS_SECRET_ID
COS_SECRET_KEY=你的COS_SECRET_KEY
COS_BUCKET=你的bucket
COS_REGION=ap-guangzhou
COS_DOMAIN=https://你的bucket.cos.ap-guangzhou.myqcloud.com
COS_PREFIX=uploads/
